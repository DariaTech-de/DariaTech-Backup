@page
@model CustomerModel
@using DariaTech.Console.Services
<h1>@Model.Customer.Name</h1><p>@Model.Customer.Number · @Model.Customer.Contact · @Model.Customer.Email · @Model.Customer.Phone</p><p>@Model.Customer.Address</p><section class="kpis"><article><small>Healthy</small><strong>@Model.Rows.Count(x=>x.Status=="Healthy")</strong></article><article><small>Warnings</small><strong>@Model.Rows.Count(x=>x.Status=="Warning")</strong></article><article><small>Critical</small><strong>@Model.Rows.Count(x=>x.Status=="Critical")</strong></article><article><small>Offline</small><strong>@Model.Rows.Count(x=>x.Status=="Offline")</strong></article><article><small>Storage-Verbrauch</small><strong>@Overview.Bytes(Model.Rows.Sum(x=>x.Storage))</strong></article></section><p>Letztes erfolgreiches Backup: @Overview.Time(Model.Rows.Select(x=>x.LastSuccess).Max())</p><partial name="_Devices" model="Model.Rows" />
<section class="panel"><h2>Standorte</h2>@foreach(var site in Model.Sites){<p>@site.Name · @site.Address</p>}@if(Model.CanManage){<form method="post" asp-page-handler="Site"><input type="hidden" name="id" value="@Model.Customer.Id"><label>Name<input name="siteName" maxlength="200" required></label><label>Adresse<input name="address" maxlength="1000"></label><button>Standort anlegen</button></form>}</section>
@if(Model.CanManage){<section class="panel"><h2>Gerät hinzufügen</h2><form method="post" asp-page-handler="Enroll"><input type="hidden" name="id" value="@Model.Customer.Id"><label>Standort<select name="siteId">@foreach(var site in Model.Sites){<option value="@site.Id">@site.Name</option>}</select></label><label>Gültigkeit in Minuten<input type="number" name="validMinutes" min="5" max="1440" value="60"></label><button>Enrollment-Token erzeugen</button></form>@if(Model.Token is not null){<p>Token einmalig angezeigt. Sicher an den Techniker übergeben.</p><code class="token">@Model.Token</code><p>Agent: enroll --token-file &lt;geschützte Datei&gt;</p>}</section>}
@if(Model.CanManage){<section class="panel"><h2>Interne Notizen</h2><p>@Model.Customer.Notes</p></section>}
<div asp-validation-summary="All"></div>
