@page
@model CustomerModel
@using DariaTech.Console.Services
@{ ViewData["Title"] = Model.Customer.Name; var c = Model.Customer; }
<nav class="breadcrumb" aria-label="Brotkrümel"><a href="/Customers">Kunden</a><span aria-hidden="true">/</span><span aria-current="page">@c.Name</span></nav>
<div class="page-heading">
 <div class="customer-head">
  <span class="customer-avatar lg" aria-hidden="true">@Ui.Initials(c.Name)</span>
  <div><span class="eyebrow">@c.Number</span><h1>@c.Name</h1>
  <ul class="contact-line">
   @if(!string.IsNullOrEmpty(c.Contact)){<li>@Ui.Icon("users")@c.Contact</li>}
   @if(!string.IsNullOrEmpty(c.Email)){<li>@Ui.Icon("mail")<a href="mailto:@c.Email">@c.Email</a></li>}
   @if(!string.IsNullOrEmpty(c.Phone)){<li>@Ui.Icon("phone")@c.Phone</li>}
   @if(!string.IsNullOrEmpty(c.Address)){<li>@Ui.Icon("pin")@c.Address</li>}
  </ul></div>
 </div>
 @if(Model.CanManage){<div class="actions"><a class="button" href="#enroll">@Ui.Icon("plus")Gerät hinzufügen</a></div>}
</div>
<section class="kpis five" aria-label="Kennzahlen">
 <article class="kpi"><span class="kpi-label"><span class="dot healthy"></span>Gesund</span><strong>@Model.Rows.Count(x=>x.Status=="Healthy")</strong></article>
 <article class="kpi"><span class="kpi-label"><span class="dot warning"></span>Warnung</span><strong>@Model.Rows.Count(x=>x.Status=="Warning")</strong></article>
 <article class="kpi"><span class="kpi-label"><span class="dot critical"></span>Kritisch</span><strong>@Model.Rows.Count(x=>x.Status=="Critical")</strong></article>
 <article class="kpi"><span class="kpi-label"><span class="dot offline"></span>Offline</span><strong>@Model.Rows.Count(x=>x.Status=="Offline")</strong></article>
 <article class="kpi"><span class="kpi-label">Speicherverbrauch</span><strong>@Ui.Size(Model.Rows.Sum(x=>x.Storage))</strong><span class="sub">Letzter Erfolg @Ui.Ago(Model.Rows.Select(x=>x.LastSuccess).Max())</span></article>
</section>
<section class="card card-flush"><div class="card-head padded"><h2>Geräte</h2></div><partial name="_Devices" model="Model.Rows" /></section>
<section class="card card-flush" id="backups">
 <div class="card-head padded"><div><h2>Backups &amp; Wiederherstellung</h2><span class="sub">Alle Backups dieses Kunden mit ihrem Speicherziel – auch von Geräten, die offline oder ersetzt sind. Wiederherstellen geht auf jedes aktive Gerät dieses Kunden.</span></div></div>
 @if(Model.RecoveryMessage is not null){<p class="@(Model.RecoveryFailed?"form-error":"notice") padded" role="status">@Model.RecoveryMessage</p>}
 @if(Model.Backups.Count==0){<p class="card-empty padded">@Ui.Icon("info")Noch keine Backup-Jobs. Legen Sie auf einem Gerät einen Job an.</p>}
 else{
 <div class="table-wrap"><table class="table">
  <thead><tr><th scope="col">Backup</th><th scope="col">Gerät</th><th scope="col">Speicherziel</th><th scope="col">Letzter Erfolg</th><th scope="col"><span class="sr-only">Aktionen</span></th></tr></thead>
  <tbody>@foreach(var b in Model.Backups){<tr>
   <td><strong>@b.Job.Name</strong>@if(b.Job.RestoreOnly){<span class="sub">Wiederherstellungs-Verbindung zu „@(b.SourceName??"Backup")“ · @(b.Job.Status=="Applied"?"bereit":b.Job.Status=="Pending"?"wird eingerichtet":"Fehler")</span>}</td>
   <td>@b.DeviceName<span class="sub">@(b.DeviceActive?$"Zuletzt online {Ui.Ago(b.LastSeen)}":"Deaktiviert")</span></td>
   <td>@b.Destination</td>
   <td>@(b.Job.RestoreOnly?"–":Ui.Ago(b.LastSuccess))</td>
   <td class="row-actions">
    @if(b.ActionsJobId is {} actions){<a class="button secondary" href="/JobActions?id=@actions">@(b.Job.RestoreOnly?"Wiederherstellen":"Aktionen")</a>}
    @if(Model.IsAdmin&&!b.Job.RestoreOnly&&b.Job.LocalJobId is not null){
    <details class="recover"><summary class="button secondary">Auf anderes Gerät wiederherstellen</summary>
     <form method="post" asp-page-handler="Recover" class="inline-form">
      <input type="hidden" name="id" value="@c.Id"><input type="hidden" name="sourceJobId" value="@b.Job.Id">
      <div class="field"><label for="target-@b.Job.Id">Zielgerät</label><select id="target-@b.Job.Id" name="targetDeviceId">@foreach(var d in Model.ActiveDevices.Where(x=>x.Id!=b.Job.DeviceId)){<option value="@d.Id">@d.Name</option>}</select></div>
      <button class="button" type="submit">Verbinden</button>
     </form>
     <span class="sub">Das Zielgerät erhält Ziel und Backup-Passwort dieses Backups und liest die Versionen direkt aus dem Speicherziel – wie „Ordner verbinden + Passwort“ in Duplicati. Es sichert darüber nicht.</span>
    </details>}
   </td>
  </tr>}</tbody>
 </table></div>}
</section>
<section class="card" id="locations">
 <div class="card-head"><div><h2>Speicherorte</h2><span class="sub">Wohin neue Backups dieses Kunden gehen. Kundeneigene Ziele haben Vorrang vor den Zielen für alle Kunden.</span></div>
  @if(Model.CanManageLocations){<a class="button secondary" href="/Targets?customer=@c.TenantId">@Ui.Icon("plus")Eigenes Ziel für diesen Kunden</a>}</div>
 @if(Model.Locations.Count==0){<p class="card-empty">@Ui.Icon("info")Kein gespeichertes Ziel. Jobs können ein eigenes Ziel verwenden.</p>}
 <ul class="site-list">@foreach(var l in Model.Locations){<li>@Ui.Icon("cloud")<span><strong>@l.Name</strong><span class="sub">@DestinationForm.Describe(l.TargetUrl)</span></span><span class="chip">@(l.TenantId is null?"Alle Kunden":"Nur dieser Kunde")@(l.IsDefault?" · Standard":"")</span></li>}</ul>
</section>
<section class="split">
 <article class="card">
  <div class="card-head"><h2>Standorte</h2><span class="chip">@Model.Sites.Count</span></div>
  @if(Model.Sites.Count==0){<p class="card-empty">@Ui.Icon("info")Noch kein Standort angelegt.</p>}
  <ul class="site-list">@foreach(var site in Model.Sites){<li>@Ui.Icon("pin")<span><strong>@site.Name</strong><span class="sub">@(string.IsNullOrEmpty(site.Address)?"Keine Adresse":site.Address)</span></span><span class="chip">@Model.Rows.Count(r=>r.Device.SiteId==site.Id) Geräte</span></li>}</ul>
  @if(Model.CanManage){
  <form method="post" asp-page-handler="Site" class="inline-form">
   <input type="hidden" name="id" value="@c.Id">
   <div class="field"><label for="siteName">Neuer Standort</label><input id="siteName" name="siteName" maxlength="200" required placeholder="z. B. Hauptsitz"></div>
   <div class="field"><label for="address">Adresse</label><input id="address" name="address" maxlength="1000"></div>
   <button class="button secondary">@Ui.Icon("plus")Standort anlegen</button>
  </form>}
 </article>
 @if(Model.CanManage){
 <article class="card" id="enroll">
  <div class="card-head"><div><h2>Gerät hinzufügen</h2><span class="sub">Plattform wählen, Token erzeugen und den Agenten mit einem Befehl installieren.</span></div></div>
  @if(Model.Sites.Count==0){<p class="card-empty">@Ui.Icon("info")Legen Sie zuerst einen Standort an.</p>}
  else{
  <form method="post" asp-page-handler="Enroll" class="enroll-form">
   <input type="hidden" name="id" value="@c.Id">
   <fieldset class="platforms"><legend>Betriebssystem des Geräts</legend>
    @foreach(var p in DariaTech.Console.Services.AgentReleases.Platforms){
    <label class="platform"><input type="radio" name="platform" value="@p" checked="@(p==Model.Platform?"checked":null)" />
     <span><strong>@DariaTech.Console.Services.AgentReleases.PlatformLabel(p)</strong><span class="sub">@(p=="win-x64"?"Installer (.exe) als Windows-Dienst":p.StartsWith("osx")?"Paket (.tar.gz) als launchd-Dienst":"Paket (.tar.gz) als systemd-Dienst")</span></span></label>}
   </fieldset>
   <label class="platform managed-optin"><input type="checkbox" name="allowManaged" value="true" checked="@(Model.AllowManaged?"checked":null)" />
    <span><strong>Backup-Jobs aus der Konsole zulassen</strong><span class="sub">Lokale Freigabe auf dem Gerät: Ohne sie übernimmt der Agent keine in der Konsole angelegten Jobs. Später nur lokal durch einen Administrator änderbar.</span></span></label>
   <div class="inline-form">
    <div class="field"><label for="siteId">Standort</label><select id="siteId" name="siteId">@foreach(var site in Model.Sites){<option value="@site.Id">@site.Name</option>}</select></div>
    <div class="field"><label for="validMinutes">Gültigkeit in Minuten</label><input id="validMinutes" type="number" name="validMinutes" min="5" max="1440" value="60"></div>
    <button class="button">@Ui.Icon("key")Token und Installationsbefehl erzeugen</button>
   </div>
  </form>}
  @if(Model.Token is not null){
  <div class="token-box" role="status">
   <span class="token-head">@Ui.Icon("key")Token wird nur einmal angezeigt</span>
   <code class="token">@Model.Token</code>
   <span class="sub">Sicher an den Techniker übergeben. Gilt für ein Gerät; nach der Registrierung ist er verbraucht.</span>
  </div>
  <div class="install-box">
   <div class="install-head"><strong>@DariaTech.Console.Services.AgentReleases.PlatformLabel(Model.Platform)</strong>
    @if(Model.Release is {} r){<span class="tag">Agent @r.Version@(r.Prerelease?" · Pilot":"")</span>}</div>
   @if(Model.Asset is {} a){
   <ol class="install-steps">
    <li>@(Model.Platform=="win-x64"?"PowerShell als Administrator öffnen.":"Terminal öffnen (Benutzer mit sudo-Rechten).")</li>
    <li>Befehl kopieren und einfügen. Er lädt das Paket, prüft die Prüfsumme und registriert das Gerät mit diesem Token.@(Model.Platform=="win-x64"?" Im Installer nur noch das Passwort für die lokale Oberfläche (mind. 14 Zeichen) vergeben.":"")</li>
    <li>@(Model.AllowManaged?"Das Gerät erscheint danach unter diesem Kunden; Backup-Jobs legen Sie dann in der Konsole an.":"Das Gerät erscheint danach unter diesem Kunden. Konsolen-Jobs sind nicht freigegeben; Jobs werden lokal auf dem Gerät eingerichtet.")</li>
   </ol>
   <div class="command"><pre><code data-copy-source>@Model.Command</code></pre><button type="button" class="button secondary" data-copy>Befehl kopieren</button></div>
   <p class="sub">Alternativ manuell: <a href="@a.Url" rel="noopener">@Ui.Icon("download")@a.File</a> (@((a.Size/1048576.0).ToString("0.0")) MB) · SHA-256 <span class="code hash">@a.Sha256</span>
    @if(Model.Platform=="win-x64"){<text>· Im Installer Konsolen-Adresse und Token eingeben.</text>}else{<text>· Danach <span class="code">sudo ./install.sh --console-url … --enrollment-token-file …</span></text>}</p>
   @if(Model.Platform!="win-x64"&&Model.Platform.StartsWith("osx")){<p class="sub">@Ui.Icon("info")Die macOS-Binärdateien sind noch nicht notarisiert; der Befehl oben funktioniert trotzdem, da er ohne Finder/Gatekeeper-Download auskommt.</p>}
   @if(Model.Platform=="win-x64"){<p class="sub">@Ui.Icon("info")Der Installer ist noch nicht code-signiert; Windows SmartScreen kann beim manuellen Start warnen.</p>}
   }else{
   <p class="card-empty">@Ui.Icon("info")Kein veröffentlichtes Agent-Paket gefunden. Paket von <a href="@Model.ReleasesPage" rel="noopener">GitHub Releases</a> laden und im Installer bzw. mit <span class="code">install.sh --enrollment-token-file</span> diesen Token verwenden.</p>
   }
  </div>}
 </article>}
</section>
@if(Model.CanManage&&!string.IsNullOrWhiteSpace(c.Notes)){<section class="card"><h2>Interne Notizen</h2><p class="prewrap">@c.Notes</p></section>}
<partial name="_Errors" model='""' />
