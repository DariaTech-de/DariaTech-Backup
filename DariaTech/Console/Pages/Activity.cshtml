@page
@model ActivityModel
@using DariaTech.Console.Services
@{ ViewData["Title"] = "Aktivitäten"; }
<div class="page-heading"><div><span class="eyebrow">Überwachen</span><h1>Aktivitäten</h1><p class="lead">Revisionssicheres Protokoll der letzten @Model.Items.Count Ereignisse.</p></div></div>
@if(Model.Items.Count==0){<div class="empty"><span class="empty-icon">@Ui.Icon("activity")</span><h2>Noch keine Aktivitäten</h2><p>Anmeldungen, Änderungen und Agent-Ereignisse werden hier protokolliert.</p></div>}
else{<section class="card card-flush"><div class="table-wrap"><table class="table"><thead><tr><th scope="col">Zeit</th><th scope="col">Aktion</th><th scope="col">Benutzer / Agent</th><th scope="col">Ressource</th></tr></thead><tbody>
@foreach(var row in Model.Items){<tr><td class="mono">@Ui.Date(row.Time)</td><td><span class="tag @(row.Action.EndsWith(".failed")?"tag-critical":"")">@row.Action</span></td><td class="code muted">@row.Actor</td><td class="code muted">@row.Resource</td></tr>}
</tbody></table></div></section>}
