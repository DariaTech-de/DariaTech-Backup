@using System.Text.Json
@{ var brand = JsonDocument.Parse(System.IO.File.ReadAllText(System.IO.Path.Combine(AppContext.BaseDirectory,"product.json"))).RootElement; }
<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@brand.GetProperty("productName").GetString()</title><link rel="icon" href="@brand.GetProperty("favicon").GetString()"><link rel="stylesheet" href="/branding/product.css"><link rel="stylesheet" href="/css/app.css"><script src="/js/app.js" defer></script></head>
<body><aside><a class="brand" href="/"><img src="@brand.GetProperty("logo").GetString()" alt="">@brand.GetProperty("productName").GetString()</a><small>@brand.GetProperty("companyName").GetString()</small><nav><a href="/">Dashboard</a><a href="/Customers">Kunden</a><a href="/Devices">Geräte</a><a href="/Backups">Backups</a><a href="/Alerts">Warnungen</a><a href="/Activity">Aktivitäten</a><a href="/Users">Benutzer</a><a href="/Settings">Einstellungen</a></nav><a href="/Licenses">Lizenzen / Open Source</a></aside>
<div class="workspace"><header><form action="/Devices" method="get"><input name="q" type="search" placeholder="Kunden und Geräte suchen" aria-label="Globale Suche"></form><a href="/Alerts">Benachrichtigungen</a><button type="button" id="theme">Hell / Dunkel</button>@if(User.Identity?.IsAuthenticated==true){<span>@User.Identity.Name</span><form method="post" asp-page="/Logout"><button>Abmelden</button></form>}</header><main>@RenderBody()</main><footer>@brand.GetProperty("companyName").GetString() · <a href="@brand.GetProperty("supportUrl").GetString()">Support</a> · <a href="mailto:@brand.GetProperty("supportEmail").GetString()">@brand.GetProperty("supportEmail").GetString()</a> · <a href="@brand.GetProperty("supportPhoneUri").GetString()">@brand.GetProperty("supportPhone").GetString()</a> · <a href="@brand.GetProperty("legalUrl").GetString()">Impressum</a> · <a href="/Licenses">Open Source</a></footer></div></body></html>
