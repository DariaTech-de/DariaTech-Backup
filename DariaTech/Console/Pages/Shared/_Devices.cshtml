@using DariaTech.Console.Services
@model IReadOnlyList<DeviceRow>
@if(Model.Count==0){
<div class="empty">
 <span class="empty-icon">@Ui.Icon("device")</span>
 <h2>Noch keine Geräte</h2>
 <p>Legen Sie Kunde und Standort an, erzeugen Sie einen Registrierungstoken und installieren Sie den Agenten auf dem Gerät.</p>
 <a class="button" href="/Customers">@Ui.Icon("plus")Kundenverwaltung öffnen</a>
</div>
}else{
<div class="table-wrap">
<table class="table">
 <thead><tr><th scope="col">Gerät</th><th scope="col">Kunde · Standort</th><th scope="col">Status</th><th scope="col">Letzter Erfolg</th><th scope="col">Letzter Lauf</th><th scope="col">Nächster Lauf</th><th scope="col">Gesichert</th><th scope="col">Agent</th></tr></thead>
 <tbody>
 @foreach(var r in Model){
  <tr>
   <td><a class="device-cell" href="/Device?id=@r.Device.Id"><span class="device-icon">@Ui.Icon("device")</span><span><strong>@r.Device.Name</strong><span class="sub">@r.Device.OperatingSystem</span></span></a></td>
   <td>@r.Customer<span class="sub">@r.Site</span></td>
   <td><span class="status @Ui.StatusClass(r.Status)">@Ui.StatusLabel(r.Status)</span></td>
   <td>@Ui.Ago(r.LastSuccess)<span class="sub">@Ui.Date(r.LastSuccess)</span></td>
   <td>
    @if(r.Device.Progress is {} progress){<span class="status running">Läuft · @((int)Math.Round(progress*100)) %</span>}
    else if(r.LastRun is {} run){<span class="status @Ui.RunClass(run.Status)">@Ui.RunLabel(run.Status)</span>@if(!string.IsNullOrEmpty(run.ErrorCode)){<span class="sub code">@run.ErrorCode</span>}}
    else{<span class="muted">Noch kein Backup</span>}
   </td>
   <td>@Ui.In(r.NextRun)</td>
   <td class="mono">@(r.Storage>0?Ui.Size(r.Storage):"—")<span class="sub">@(r.LastRun?.Completed is {} end ? Ui.Duration(end-r.LastRun.Started) : "")</span></td>
   <td class="mono muted">@r.Version</td>
  </tr>
 }
 </tbody>
</table>
</div>
}
