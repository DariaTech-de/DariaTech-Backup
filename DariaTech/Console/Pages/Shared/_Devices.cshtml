@using DariaTech.Console.Services
@model IReadOnlyList<DeviceRow>
@if(Model.Count==0){<div class="empty"><h2>Noch keine Geräte</h2><p>Kunde und Standort anlegen, Enrollment-Token erzeugen und Agent registrieren.</p><a class="button" href="/Customers">Kundenverwaltung öffnen</a></div>}else{<div class="table-wrap"><table><thead><tr><th>Status / Gerät</th><th>Kunde / Standort</th><th>System / Agent</th><th>Letzter Kontakt</th><th>Letztes erfolgreiches Backup</th><th>Letzter Lauf / Engine-Ereignis</th><th>Nächster Lauf</th><th>Dauer / Daten</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><span class="status @r.Status.ToLowerInvariant()">@r.Status</span><a href="/Device?id=@r.Device.Id"><strong>@r.Device.Name</strong></a></td><td>@r.Customer<small>@r.Site</small></td><td>@r.Device.OperatingSystem<small>Agent @r.Version</small></td><td>@Overview.Time(r.Device.LastHeartbeat)</td><td>@Overview.Time(r.LastSuccess)</td><td>@(r.Device.Progress is {} progress?$"Running ({progress:P0})":r.LastRun?.Status.ToString()??"Noch kein Backup")<small>@r.LastRun?.ErrorCode</small></td><td>@Overview.Time(r.NextRun)</td><td>@(r.LastRun?.Completed is {} end ? (end-r.LastRun.Started).ToString(@"hh\:mm\:ss") : "—")<small>@Overview.Bytes(r.LastRun?.Bytes) · @(r.LastRun?.Files?.ToString()??"Unbekannt") Dateien</small></td></tr>}</tbody></table></div>}
