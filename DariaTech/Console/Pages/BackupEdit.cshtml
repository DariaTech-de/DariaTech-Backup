@page
@model BackupEditModel
@using DariaTech.Contracts
@using DariaTech.Console.Services
@{
 var isNew = Model.ManagedJobId is null;
 ViewData["Title"] = isNew ? "Backup-Job anlegen" : "Backup-Job bearbeiten";
 var providers = new[]{("Files","Dateien und Ordner","device"),("NAS","NAS-Freigabe","server"),("Proxmox","Proxmox VM/LXC","server"),("Microsoft365","Microsoft 365","cloud"),("GoogleWorkspace","Google Workspace","cloud")};
 var current = Model.DestinationKey ?? Model.Destination.Key;
 var types = DestinationCatalog.All.Where(t => (!t.Deprecated && !t.Untested) || t.Key == current).ToList();
 var recommended = DestinationForm.Recommended.Select(DestinationCatalog.Find).OfType<DestinationType>().Where(types.Contains).ToList();
 var others = types.Except(recommended).OrderBy(DestinationForm.Label).ToList();
 string Val(string type, string name) => type == current && Model.OptionValues.TryGetValue(name, out var v) ? v : "";
}
<nav class="breadcrumb" aria-label="Brotkrümel"><a href="/Devices">Geräte</a><span aria-hidden="true">/</span><a href="/Device?id=@Model.DeviceId">@Model.Device.Name</a><span aria-hidden="true">/</span><span aria-current="page">@ViewData["Title"]</span></nav>
<div class="page-heading"><div><span class="eyebrow">@Model.Device.Name</span><h1>@ViewData["Title"]</h1><p class="lead">Quelle, Ziel, Verschlüsselung und Zeitplan – wie in Duplicati, zentral verwaltet.</p></div></div>
@if(Model.Error is not null){<div class="form-error" role="alert">@Model.Error</div>}

@if(isNew){
<nav class="seg" aria-label="Art der Sicherung">
 @foreach(var (key,label,icon) in providers){<a asp-page="/BackupEdit" asp-route-deviceId="@Model.DeviceId" asp-route-provider="@key" aria-current="@(Model.Provider==key?"page":null)">@Ui.Icon(icon)@label</a>}
</nav>}

<form method="post" class="stack">
 <input type="hidden" asp-for="DeviceId" /><input type="hidden" asp-for="ManagedJobId" /><input type="hidden" asp-for="Revision" /><input type="hidden" asp-for="Provider" />

 <section class="card">
  <div class="card-head"><div><h2><span class="step">1</span>Was wird gesichert?</h2><span class="sub">Quelle auf dem Gerät @Model.Device.Name</span></div></div>
  <div class="field"><label asp-for="Name">Jobname</label><input asp-for="Name" required maxlength="200" placeholder="z. B. Dateiserver täglich" /></div>
  @if(Model.Provider is "Files" or "NAS"){
   <div class="field"><label asp-for="Sources"><span>Quellordner</span><span class="label-hint">ein absoluter Pfad je Zeile</span></label><textarea asp-for="Sources" required rows="4" placeholder="C:\Users&#10;D:\Daten&#10;/srv/daten"></textarea></div>
  } else if(Model.Provider=="Proxmox"){
   <div class="field"><label asp-for="ProxmoxGuestIds"><span>Proxmox-Gast-IDs</span><span class="label-hint">durch Kommas getrennt</span></label><input asp-for="ProxmoxGuestIds" required placeholder="101, 102" /></div>
   <p class="hint">@Ui.Icon("info")Der Agent muss auf dem Proxmox-Host installiert sein. Vor jeder Sicherung erstellt vzdump vollständige Snapshot-Archive; Gast-IDs und Staging-Speicher müssen lokal freigegeben sein.</p>
  } else {
   <div class="form-grid">
    <div class="field"><label asp-for="DirectoryTenant">@(Model.Provider=="Microsoft365"?"Microsoft-Tenant-ID":"Google-Workspace-Domain")</label><input asp-for="DirectoryTenant" required /></div>
    @if(Model.Provider=="Microsoft365"){
     <div class="field"><label asp-for="ClientId">Anwendungs-ID</label><input asp-for="ClientId" /></div>
     <div class="field span-2"><label for="ClientSecret"><span>Client Secret</span><span class="label-hint">leer lassen, um das gespeicherte zu behalten</span></label><input type="password" name="ClientSecret" id="ClientSecret" autocomplete="new-password" /></div>
    } else {
     <div class="field"><label asp-for="AdminEmail">Delegierter Workspace-Administrator</label><input asp-for="AdminEmail" type="email" required /></div>
     <div class="field span-2"><label for="ServiceAccountJson">Service-Account-JSON mit Domain-wide Delegation</label><textarea name="ServiceAccountJson" id="ServiceAccountJson" rows="3" autocomplete="off"></textarea></div>
    }
    <div class="field"><label asp-for="RootTypes">Bereiche</label><select asp-for="RootTypes" multiple size="5">@foreach(var root in Model.Provider=="Microsoft365"?new[]{"Users","Groups","Sites"}:new[]{"Users","Groups","SharedDrives","Sites","OrganizationalUnits"}){<option value="@root">@root</option>}</select></div>
    <div class="field"><label asp-for="UserTypes">Benutzerdaten</label><select asp-for="UserTypes" multiple size="7">@foreach(var type in Model.Provider=="Microsoft365"?new[]{"Profile","Mailbox","Calendar","Contacts","Tasks","Notes","Planner","Chats"}:new[]{"Gmail","Drive","Calendar","Contacts","Tasks","Keep","Chat"}){<option value="@type">@type</option>}</select></div>
   </div>
   <p class="hint">@Ui.Icon("info")M365-OneDrive und SharePoint werden über „Sites“ erfasst. Die Abdeckung hängt von Berechtigungen, Lizenz und Provider ab.</p>
  }
  @if(Model.Provider=="NAS"){
   <div class="field"><label asp-for="SourceMounts"><span>Erwartete NAS-Mounts</span><span class="label-hint">Mountpunkt|Dateisystem|Remote-Quelle je Zeile</span></label><textarea asp-for="SourceMounts" required rows="3" placeholder="/mnt/kunde|nfs4|nas.example:/daten"></textarea></div>
   <p class="hint">@Ui.Icon("info")Die Freigabe wird lokal vom Betriebssystem eingehängt; jede Sicherung prüft die Mount-Identität. Zugangsdaten gehören nicht in dieses Feld.</p>
  }
  @if(Model.Provider is "Files" or "NAS"){<div class="field"><label asp-for="Excludes"><span>Ausschlussfilter</span><span class="label-hint">optional, einer je Zeile</span></label><textarea asp-for="Excludes" rows="2" placeholder="*.tmp&#10;*/Temp/*"></textarea></div>}
 </section>

 <section class="card">
  <div class="card-head"><div><h2><span class="step">2</span>Wohin wird gesichert?</h2><span class="sub">Alle Speicherziele der Backup-Engine. Zugangsdaten werden verschlüsselt gespeichert und nur an diesen Agenten übertragen.</span></div></div>
  @if(!isNew){<p class="hint">@Ui.Icon("lock")Das Ziel eines bestehenden Jobs ist fest, damit die Backup-Kette lesbar bleibt. Zugangsdaten und Optionen können Sie ändern; für ein anderes Ziel legen Sie einen neuen Job an.</p>}
  <div class="field">
   <label for="dest-key">Speicherziel</label>
   <select id="dest-key" name="DestinationKey" data-dest-picker disabled="@(isNew?null:"disabled")">
    <optgroup label="Häufig genutzt">@foreach(var t in recommended){<option value="@t.Key" selected="@(t.Key==current?"selected":null)">@DestinationForm.Label(t)</option>}</optgroup>
    <optgroup label="Weitere Ziele">@foreach(var t in others){<option value="@t.Key" selected="@(t.Key==current?"selected":null)">@DestinationForm.Label(t)</option>}</optgroup>
   </select>
   @if(!isNew){<input type="hidden" name="DestinationKey" value="@current" />}
  </div>
  @foreach(var t in types){
   var active = t.Key == current;
   var options = DestinationForm.Ordered(t).Where(o => !DestinationForm.Forced(t.Key).ContainsKey(o.Name)).ToList();
   var main = options.Where(o => !DestinationForm.Advanced(o)).ToList();
   var advanced = options.Where(DestinationForm.Advanced).ToList();
   <fieldset class="dest-panel @(active?"active":"")" data-dest="@t.Key" disabled="@(active?null:"disabled")">
    <legend class="sr-only">@DestinationForm.Label(t)</legend>
    @if(DestinationForm.Hint(t.Key) is {} hint){<p class="hint">@Ui.Icon("info")@hint</p>}
    <div class="form-grid">
     @if(DestinationForm.HasHost(t.Key)){<div class="field"><label for="d-@t.Key-host">@DestinationForm.HostLabel(t.Key)</label><input id="d-@t.Key-host" name="@($"dest.{t.Key}.host")" value="@(active?Model.Destination.Host:"")" readonly="@(isNew?null:"readonly")" required /></div>}
     @if(DestinationForm.HasPort(t.Key)){<div class="field"><label for="d-@t.Key-port"><span>Port</span><span class="label-hint">optional</span></label><input id="d-@t.Key-port" name="@($"dest.{t.Key}.port")" inputmode="numeric" value="@(active?Model.Destination.Port:"")" readonly="@(isNew?null:"readonly")" /></div>}
     @if(DestinationForm.HasPath(t.Key)){<div class="field @(t.Key=="file"?"span-2":"")"><label for="d-@t.Key-path">@DestinationForm.PathLabel(t.Key)</label><input id="d-@t.Key-path" name="@($"dest.{t.Key}.path")" value="@(active?Model.Destination.Path:"")" readonly="@(isNew?null:"readonly")" required="@(t.Key=="file"?"required":null)" /></div>}
     @foreach(var o in main){<partial name="_DestinationOption" model="(t, o, Val(t.Key, o.Name), active && Model.StoredSecrets.Contains(o.Name))" />}
    </div>
    @if(advanced.Count>0){
    <details class="advanced"><summary>Erweiterte Optionen <span class="chip">@advanced.Count</span></summary>
     <div class="form-grid">@foreach(var o in advanced){<partial name="_DestinationOption" model="(t, o, Val(t.Key, o.Name), active && Model.StoredSecrets.Contains(o.Name))" />}</div>
    </details>}
   </fieldset>
  }
 </section>

 <section class="card">
  <div class="card-head"><div><h2><span class="step">3</span>Verschlüsselung</h2><span class="sub">AES-256 auf dem Gerät, bevor Daten das Gerät verlassen.</span></div></div>
  <div class="field"><label for="Passphrase"><span>Backup-Passphrase</span><span class="label-hint">@(isNew?"mindestens 14 Zeichen":"leer lassen, um sie zu behalten")</span></label><input type="password" name="Passphrase" id="Passphrase" autocomplete="new-password" minlength="14" required="@(isNew?"required":null)" /></div>
  <p class="hint">@Ui.Icon("key")Ohne diese Passphrase lassen sich die Sicherungen nicht wiederherstellen. Bewahren Sie sie getrennt vom Gerät auf.</p>
 </section>

 <section class="card">
  <div class="card-head"><div><h2><span class="step">4</span>Zeitplan und Aufbewahrung</h2></div></div>
  <div class="form-grid">
   <div class="field"><label asp-for="FirstRun"><span>Erster Lauf (UTC)</span><span class="label-hint">leer = nur manuell</span></label><input asp-for="FirstRun" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div>
   <div class="field"><label asp-for="RepeatHours">Wiederholung (Stunden)</label><input asp-for="RepeatHours" type="number" min="1" max="8760" /></div>
   <div class="field"><label asp-for="Days">Wochentage</label><select asp-for="Days" multiple size="7">@foreach(var day in Enum.GetValues<DayOfWeek>()){<option value="@day">@System.Globalization.CultureInfo.GetCultureInfo("de-DE").DateTimeFormat.GetDayName(day)</option>}</select></div>
   <div class="field"><label asp-for="KeepVersions">Aufzubewahrende Versionen</label><input asp-for="KeepVersions" type="number" min="1" max="10000" /></div>
  </div>
 </section>

 <div class="form-actions">
  <a class="button secondary" href="/Device?id=@Model.DeviceId">Abbrechen</a>
  <button type="submit">@Ui.Icon("check")Konfiguration speichern</button>
 </div>
 <p class="sub">Der Agent übernimmt die Konfiguration beim nächsten Abgleich, sofern die zentrale Konfiguration auf dem Gerät freigegeben ist. SaaS-Quellen benötigen zusätzlich die lokale Tenant-Freigabe.</p>
</form>
