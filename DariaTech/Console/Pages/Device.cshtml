@page
@model DeviceModel
@using DariaTech.Console.Services
<h1>@Model.Row.Device.Name <span class="status @Model.Row.Status.ToLowerInvariant()">@Model.Row.Status</span></h1><p>@Model.Row.Customer → @Model.Row.Site → @Model.Row.Device.Hostname</p><section class="panel"><dl><dt>Betriebssystem</dt><dd>@Model.Row.Device.OperatingSystem</dd><dt>Agent-Version</dt><dd>@Model.Row.Version</dd><dt>Letzter Heartbeat</dt><dd>@Overview.Time(Model.Row.Device.LastHeartbeat)</dd><dt>Letzter erfolgreicher Lauf</dt><dd>@Overview.Time(Model.Row.LastSuccess)</dd><dt>Letzter fehlgeschlagener Lauf</dt><dd>@Overview.Time(Model.Runs.Where(x=>x.Status==RunStatus.Failed).Select(x=>(DateTimeOffset?)(x.Completed??x.Started)).Max())</dd><dt>Storage</dt><dd>@Overview.Bytes(Model.Row.Storage)</dd></dl></section>@if(Model.Row.Device.Progress is {} progress){<section class="panel"><h2>Aktiver Backup-/Restore-Vorgang</h2><p>@(progress*100)% · @Overview.Bytes(Model.Row.Device.ProgressBytes) · @Model.Row.Device.ProgressFiles Dateien</p></section>}<section class="panel"><h2>Backup-Jobs</h2>@foreach(var j in Model.Jobs){<p><strong>@j.Name</strong> · @j.Ownership · Nächster Lauf: @Overview.Time(j.NextRun) @if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")||User.IsInRole("Technician")){<a asp-page="/JobActions" asp-route-id="@j.Id">Aktionen / Restore</a>}</p>}@if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")){<p><a asp-page="/BackupEdit" asp-route-deviceId="@Model.Row.Device.Id">Backup-Job anlegen</a></p>@foreach(var managed in Model.Managed){<p>@managed.Name · @managed.Status · Revision @managed.AppliedRevision / @managed.LatestRevision · <a asp-page="/BackupEdit" asp-route-deviceId="@Model.Row.Device.Id" asp-route-id="@managed.Id">Konfiguration ändern</a></p>}}<p class="muted">Lokal erstellte Jobs bleiben lokal verwaltet. Zentrale Jobs verwenden versionierte, verschlüsselte Konfigurationen.</p></section><section class="panel"><h2>Backup-Historie</h2><table><thead><tr><th>Start / Ereigniszeit</th><th>Status</th><th>Daten</th><th>Dateien</th><th>Fehlercode</th></tr></thead><tbody>@foreach(var r in Model.Runs){<tr><td>@Overview.Time(r.Started)</td><td>@r.Status</td><td>@Overview.Bytes(r.Bytes)</td><td>@(r.Files?.ToString()??"Unbekannt")</td><td>@r.ErrorCode</td></tr>}</tbody></table></section><section class="panel"><h2>Restore und Remote-Aktionen</h2><p>Aktionen und Restore werden über den jeweiligen Backup-Job angefordert. Remote-Restore benötigt eine zweite Administratorfreigabe und die lokale Freigabe des Agenten.</p><h2>Logs und Aufbewahrung</h2><p>Rohe Logs und Dateipfade bleiben aus Datenschutzgründen lokal. Zentral werden Fehlercodes übertragen. Gemeldete Retention- und Speicherfehler erscheinen in den zentralen Warnungen.</p></section>
