@page
@model DeviceModel
@using DariaTech.Console.Services
@using DariaTech.Contracts
@{
 var row = Model.Row; var d = row.Device;
 ViewData["Title"] = d.Name;
 var today = DateOnly.FromDateTime(DateTime.UtcNow);
 var strip = Enumerable.Range(0, 30).Select(i => today.AddDays(i - 29)).Select(day => {
  var runs = Model.Recent.Where(r => DateOnly.FromDateTime(r.Started.UtcDateTime) == day).ToList();
  var cls = runs.Count == 0 ? "none" : runs.Any(r => r.Status == RunStatus.Failed) ? "critical" : runs.Any(r => r.Status is RunStatus.Warning or RunStatus.Cancelled or RunStatus.Unknown) ? "warning" : runs.Any(r => r.Status == RunStatus.Success) ? "healthy" : "none";
  return (Day: day, Class: cls, Count: runs.Count);
 }).ToList();
 var recent = Model.Recent.Where(r => r.Status != RunStatus.Running).ToList();
 var recentOk = recent.Count(r => r.Status == RunStatus.Success);
 var durations = Model.Runs.Where(r => r.Status == RunStatus.Success && r.Completed is not null).Take(20).Select(r => r.Completed!.Value - r.Started).ToList();
 var lastFailed = Model.Runs.Where(x => x.Status == RunStatus.Failed).Select(x => (DateTimeOffset?)(x.Completed ?? x.Started)).Max();
}
<nav class="breadcrumb" aria-label="Brotkrümel"><a href="/Devices">Geräte</a><span aria-hidden="true">/</span><span>@row.Customer</span><span aria-hidden="true">/</span><span>@row.Site</span><span aria-hidden="true">/</span><span aria-current="page">@d.Name</span></nav>

<section class="card device-hero">
 <span class="device-avatar">@Ui.Icon("server")</span>
 <div class="device-title">
  <div class="title-row"><h1>@d.Name</h1><span class="status lg @Ui.StatusClass(row.Status)">@Ui.StatusLabel(row.Status)</span></div>
  <p class="lead">@d.OperatingSystem · Agent @row.Version · Engine @(d.EngineReachable ? "erreichbar" : "nicht erreichbar") · Letzter Kontakt @Ui.Ago(d.LastHeartbeat)</p>
 </div>
 <div class="actions">
  @if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")||User.IsInRole("Technician")){<a class="button" href="#backup-jobs">@Ui.Icon("server")Backup-Aktionen / Restore</a>}
  @if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")){<a class="button" asp-page="/BackupEdit" asp-route-deviceId="@d.Id">Backup-Job anlegen</a>}
 </div>
 <p id="remote-hint" class="hint">@Ui.Icon("info")Backup-Aktionen werden am jeweiligen Job angefordert. Gibt es einen zweiten Administrator, muss er eine Wiederherstellung freigeben.</p>
</section>

@if(Model.Message is not null){<p class="notice-inline good" role="status">@Ui.Icon("check")@Model.Message</p>}
@if(Model.Failure is not null){<p class="form-error" role="alert">@Model.Failure</p>}
@if(Model.Protection is {} prot){
<section class="card" id="protection">
 <div class="card-head"><div><h2>Schutzstatus @if(prot.Accepted){<span class="status healthy">abgenommen</span>}else{<span class="status warning">noch nicht abgenommen</span>}</h2><span class="sub">Nächster Schritt: @prot.NextAction</span></div></div>
 <ol class="steps-list">
  <li><span class="status @(prot.Connected?"healthy":"offline")">@(prot.Connected?"Agent verbunden":"Agent nicht verbunden")</span> · <span class="status @(prot.EngineReady?"healthy":"offline")">@(prot.EngineReady?"Backup-Engine bereit":"Backup-Engine nicht bereit")</span></li>
  @{var cfg=Onboarding.Label(prot.Configuration,"Konfiguration übernommen","Konfiguration ausstehend","Konfiguration wird übernommen","Konfiguration fehlgeschlagen");}
  <li><span class="status @cfg.Css">@cfg.Text</span> – gespeichert heißt noch nicht angewendet; maßgeblich ist die Bestätigung des Geräts.</li>
  <li><span class="status @(prot.StorageReached?"healthy":"offline")">@(prot.StorageReached?"Speicher vom Gerät erreicht":"Speicher-Erreichbarkeit nicht nachgewiesen")</span> – nachgewiesen durch einen Verbindungstest dieses Geräts oder eine erfolgreiche Sicherung. Das Gerät sichert direkt zum Speicher; die Daten laufen nicht über die Console.</li>
  @{var fb=Onboarding.Label(prot.FirstBackup,"Erstsicherung erfolgreich","Erstsicherung ausstehend","Erstsicherung läuft","Erstsicherung fehlgeschlagen");}
  <li><span class="status @fb.Css">@fb.Text</span>@if(prot.LastSuccess is {} at){<text> · zuletzt @Ui.Date(at)</text>} – große Erstsicherungen können Tage dauern; nach einer Unterbrechung setzt der nächste Lauf fort, bereits übertragene Blöcke werden nicht erneut hochgeladen.</li>
  @{var rt=Onboarding.Label(prot.RestoreTest,"Restore-Test bestätigt (manuell)","Restore-Test ausstehend","Restore technisch abgeschlossen – Dateien noch prüfen","Wiederherstellung fehlgeschlagen");}
  <li><span class="status @rt.Css">@rt.Text</span> – Beispieldatei in einen neuen Ordner wiederherstellen, öffnen und unter „Aktionen / Restore“ bestätigen. Eine Backup-Prüfung ersetzt keinen Restore-Test.</li>
  <li><span class="status @(prot.NextRun is not null||prot.ManualOnly?"healthy":"offline")">@(prot.ManualOnly?"Nur manuell (kein Zeitplan)":prot.NextRun is {} next?$"Nächster automatischer Lauf {Ui.Date(next)}":"Kein nächster Lauf bekannt")</span></li>
 </ol>
</section>
}
@if(Model.IsMac){
<section class="card">
 <div class="card-head"><div><h2>Mac: Festplattenvollzugriff</h2><span class="sub">Ohne diese Freigabe kann macOS Dokumente, Schreibtisch und Downloads nicht sichern lassen.</span></div></div>
 <ol class="steps-list">
  <li>Auf dem Mac <strong>Systemeinstellungen → Datenschutz &amp; Sicherheit → Festplattenvollzugriff</strong> öffnen.</li>
  <li>Auf <strong>„+“</strong> klicken, <strong>⇧⌘G</strong> drücken und <span class="code">/Library/Application Support/DariaTechBackup/agent/DariaTech.Agent</span> einfügen, dann „Öffnen“.</li>
  <li>Den Schalter bei <strong>DariaTech.Agent</strong> einschalten. Nach einem Agent-Update kann macOS das erneut verlangen.</li>
 </ol>
</section>
}
@if(Model.Candidates.Count>0){
<section class="card@(Model.Suggested is not null?" highlight":"")" id="replace">
 <div class="card-head"><div><h2>Gerät ersetzen – Backups übernehmen</h2>
  <span class="sub">@if(Model.Suggested is {} s){<text>„@s.Device.Name“ (zuletzt online @Ui.Ago(s.Device.LastHeartbeat)) hat denselben Namen. Ist dies eine Neuinstallation oder ein Ersatzgerät, übernimmt dieses Gerät die Backups mit Ziel, Passphrase und Zeitplan und sichert in derselben Versionskette weiter.</text>}else{<text>Ersetzt dieses Gerät ein anderes Gerät des Kunden, übernimmt es dessen Backups mit Ziel, Passphrase und Zeitplan und sichert in derselben Versionskette weiter.</text>}</span></div></div>
 <form method="post" asp-page-handler="Replace" asp-route-id="@d.Id" class="form-grid">
  <div class="field"><label for="oldDeviceId">Altes Gerät</label><select name="oldDeviceId" id="oldDeviceId">@foreach(var c in Model.Candidates){<option value="@c.Device.Id" selected="@(c==Model.Suggested)">@c.Device.Name · @c.Jobs Backup@(c.Jobs==1?"":"s") · @(c.Device.Active?$"zuletzt online {Ui.Ago(c.Device.LastHeartbeat)}":"deaktiviert")</option>}</select></div>
  <p class="hint">@Ui.Icon("info")Das alte Gerät wird in der Console deaktiviert und beim nächsten Kontakt angewiesen, seine Zeitpläne anzuhalten. Dieses Gerät beginnt erst, wenn das alte den Stopp bestätigt hat – oder Sie bestätigen, dass es nie wieder online kommt. So schreiben nie zwei Geräte gleichzeitig in dieselbe Backup-Kette.</p>
  <label class="check"><input type="checkbox" name="confirm" value="true" /> Dieses Gerät ersetzt das ausgewählte Gerät dauerhaft.</label>
  <div><button type="submit" class="button">Backups übernehmen</button></div>
 </form>
</section>
}
@foreach(var h in Model.PendingHandovers){
<section class="banner warning" role="status">
 <span class="banner-icon">@Ui.Icon("alert")</span>
 <div><strong>Übernahme wartet: „@h.Old.Name“ hat den Stopp noch nicht bestätigt</strong>
  <span>@h.Jobs Backup@(h.Jobs==1?"":"s") werden erst auf dieses Gerät verteilt, wenn das alte Gerät seine Zeitpläne angehalten hat. Angefordert @Ui.Ago(h.Old.RetireRequested) · zuletzt online @Ui.Ago(h.Old.LastHeartbeat).
  Kommt das alte Gerät nie wieder online (neu installiert, defekt, verloren), können Sie das hier bestätigen. Das ist dann keine technische Bestätigung: Agent dort deinstallieren bzw. Gerät löschen und – falls möglich – den Speicherzugang des alten Geräts ändern.</span>
  @if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")){
  <form method="post" asp-page-handler="ConfirmStopped" asp-route-id="@d.Id" class="form-grid">
   <input type="hidden" name="oldDeviceId" value="@h.Old.Id" />
   <label class="check"><input type="checkbox" name="confirm" value="true" /> „@h.Old.Name“ sichert nicht mehr und wird nicht wieder eingeschaltet.</label>
   <button type="submit" class="button">Manuell bestätigen</button>
  </form>}
 </div>
</section>
}
@if(d.RetireRequested is not null){
<section class="banner warning" role="status"><span class="banner-icon">@Ui.Icon("alert")</span>
 <div><strong>Stilllegung angefordert @Ui.Ago(d.RetireRequested)</strong><span>Das Gerät hält seine Zeitpläne beim nächsten Kontakt an und bestätigt das; bis dahin ist der Stopp nicht bestätigt.</span></div></section>
}
@foreach(var a in Model.Alerts.Take(3)){
<section class="banner @Ui.SeverityClass(a.Severity)" role="alert">
 <span class="banner-icon">@Ui.Icon("alert")</span>
 <div><strong>@Ui.AlertTitle(a.Code)</strong><span>Seit @Ui.Date(a.Opened) · zuletzt erkannt @Ui.Ago(a.LastSeen) · Code <span class="code">@a.Code</span></span></div>
</section>
}

@if(d.Progress is {} progress){var p=(int)Math.Round(progress*100);
<section class="card">
 <div class="card-head"><h2>Aktiver Backup- oder Restore-Vorgang</h2><span class="mono big">@p %</span></div>
 <progress max="100" value="@p" aria-label="Fortschritt">@p %</progress>
 <span class="sub">@Ui.Size(d.ProgressBytes) · @Ui.Number(d.ProgressFiles) Dateien verarbeitet</span>
</section>
}

<section class="kpis" aria-label="Kennzahlen">
 <article class="kpi"><span class="kpi-label">Letzter Erfolg</span><strong>@Ui.Ago(row.LastSuccess)</strong><span class="sub">@Ui.Date(row.LastSuccess)</span></article>
 <article class="kpi"><span class="kpi-label">Gesicherte Daten</span><strong>@(row.Storage>0?Ui.Size(row.Storage):"—")</strong><span class="sub">@row.Jobs Backup-Job@(row.Jobs==1?"":"s")</span></article>
 <article class="kpi"><span class="kpi-label">Erfolgsquote · 30 Tage</span><strong>@(recent.Count==0?"—":Ui.Percent(recentOk*100.0/recent.Count)+" %")</strong><span class="sub">@recentOk von @recent.Count Läufen</span></article>
 <article class="kpi"><span class="kpi-label">Ø Dauer</span><strong>@(durations.Count==0?"—":Ui.Duration(TimeSpan.FromTicks((long)durations.Average(x=>x.Ticks))))</strong><span class="sub">Letzter Fehler: @Ui.Ago(lastFailed)</span></article>
</section>

<section class="card">
 <div class="card-head"><h2>Verlauf · 30 Tage</h2><ul class="chart-legend"><li><span class="swatch healthy"></span>Erfolgreich</li><li><span class="swatch warning"></span>Warnung</li><li><span class="swatch critical"></span>Fehlgeschlagen</li><li><span class="swatch none"></span>Kein Lauf</li></ul></div>
 <ol class="strip">@foreach(var s in strip){<li class="@s.Class" title="@s.Day.ToString("dd.MM.yyyy"): @(s.Count==0?"kein Lauf":s.Count+" Lauf/Läufe")"><span class="sr-only">@s.Day.ToString("dd.MM."): @s.Class</span></li>}</ol>
 <div class="strip-axis"><span>@strip[0].Day.ToString("d. MMM", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))</span><span>Heute</span></div>
</section>

<section class="split-main">
 <article class="card card-flush">
  <div class="card-head padded"><h2>Backup-Historie</h2><span class="sub">@(Model.Runs.Count>15?$"Letzte 15 von {Model.Runs.Count} Läufen":$"{Model.Runs.Count} Läufe")</span></div>
  @if(Model.Runs.Count==0){<p class="card-empty padded">@Ui.Icon("info")Für dieses Gerät wurde noch kein Backup gemeldet.</p>}
  else{
  <div class="table-wrap flush">
  <table class="table">
   <thead><tr><th scope="col">Start</th><th scope="col">Status</th><th scope="col">Dauer</th><th scope="col">Daten</th><th scope="col">Dateien</th><th scope="col">Fehlercode</th></tr></thead>
   <tbody>@foreach(var r in Model.Runs.Take(15)){<tr><td class="mono">@Ui.Date(r.Started)</td><td><span class="status @Ui.RunClass(r.Status)">@Ui.RunLabel(r.Status)</span></td><td class="mono muted">@(r.Completed is {} end?Ui.Duration(end-r.Started):"—")</td><td class="mono">@Ui.Size(r.Bytes)</td><td class="mono">@(r.Files is {} f?Ui.Number(f):"—")</td><td class="code muted">@(string.IsNullOrEmpty(r.ErrorCode)?"—":r.ErrorCode)</td></tr>}</tbody>
  </table>
  </div>}
 </article>

 <div class="stack">
  <article class="card">
   <h2 id="backup-jobs">Backup-Jobs</h2>
   @if(Model.Jobs.Count==0){<p class="card-empty">@Ui.Icon("info")Noch keine Jobs eingerichtet.</p>}
   <ul class="job-list">@foreach(var j in Model.Jobs){<li><span class="dot @(j.Active?"healthy":"offline")"></span><span><strong>@j.Name</strong><span class="sub">@Ui.Ownership(j.Ownership) · Nächster Lauf @Ui.In(j.NextRun)</span></span>@if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")||User.IsInRole("Technician")){<a asp-page="/JobActions" asp-route-id="@j.Id">Aktionen / Restore</a>}</li>}</ul>
   @if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")){@foreach(var managed in Model.Managed){<div class="managed-job"><strong>@managed.Name</strong><span class="dest-line">@Ui.Icon("cloud")Ziel: @(Model.Destinations.GetValueOrDefault(managed.Id)??"unbekannt")</span>@{var state=Ui.ConfigState(managed,Model.PendingHandovers.Any(h=>h.Old.Id==managed.HandoverFromDeviceId));}<span class="sub"><span class="status @state.Class">@state.Label</span> · @(managed.RestoreOnly?"Nur Wiederherstellung (sichert nie)":BackupAge.Describe(managed)) @if(!managed.RestoreOnly&&managed.ScheduleRecorded){<text> · @Ui.Retention(managed.KeepVersions,managed.ScheduleRepeatHours,managed.ScheduleDays)</text>} · <a asp-page="/BackupEdit" asp-route-deviceId="@d.Id" asp-route-id="@managed.Id">Konfiguration ändern</a></span></div>}}
   <p class="sub">Lokal verwaltete Jobs werden in der Backup-Engine gepflegt. Zentrale Jobs verwenden versionierte, verschlüsselte Konfigurationen.</p>
  </article>
  <article class="card">
   <h2>System</h2>
   <dl class="facts">
    <dt>Hostname</dt><dd class="code">@d.Hostname</dd>
    <dt>Kunde</dt><dd>@row.Customer</dd>
    <dt>Standort</dt><dd>@row.Site</dd>
    <dt>Letzter Heartbeat</dt><dd>@Ui.Date(d.LastHeartbeat)</dd>
    <dt>Agent</dt><dd class="mono">@row.Version</dd>
   </dl>
  </article>
  <article class="card">
   <h2>Logs und Datenschutz</h2>
   <p class="sub">Rohe Logs und Dateipfade bleiben auf dem Gerät. Zentral werden nur Fehlercodes, Zeitpunkte und Mengen übertragen.</p>
  </article>
 </div>
</section>
@if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")||User.IsInRole("Technician")){
<section class="card" id="absence">
 <div class="card-head"><div><h2>Geplante Abwesenheit</h2><span class="sub">Für Urlaub, Lager oder Reparatur: bis zum Enddatum werden „Gerät offline“ und „Backup überfällig“ nicht gemeldet. Fehlgeschlagene Sicherungen und volle Speicher weiterhin. Nach dem Enddatum gilt automatisch wieder die normale Überwachung.</span></div></div>
 @if(d.AbsentUntil is {} absent&&absent>DateTimeOffset.UtcNow){
 <p class="notice-inline" role="status">@Ui.Icon("info")Abwesend bis @Ui.Date(absent)@(string.IsNullOrEmpty(d.AbsenceNote)?"":" · "+d.AbsenceNote)</p>
 <form method="post" asp-page-handler="Absence" asp-route-id="@d.Id"><input type="hidden" name="clear" value="true" /><button type="submit" class="button secondary">Abwesenheit beenden</button></form>
 }else{
 <form method="post" asp-page-handler="Absence" asp-route-id="@d.Id" class="form-grid">
  <div class="field"><label for="absence-until">Abwesend bis einschließlich</label><input id="absence-until" type="date" name="until" /></div>
  <div class="field"><label for="absence-note">Grund (optional)</label><input id="absence-note" name="note" maxlength="200" /></div>
  <div><button type="submit" class="button secondary">Abwesenheit eintragen</button></div>
 </form>}
</section>
}
@if((User.IsInRole("SuperAdmin")||User.IsInRole("Administrator"))&&d.RetireRequested is null){
<section class="card" id="decommission">
 <div class="card-head"><div><h2>Gerät stilllegen</h2><span class="sub">Für ein Gerät, das nicht mehr gesichert werden soll und nicht ersetzt wird. Ersetzt ein neues Gerät dieses, stattdessen am neuen Gerät „Gerät ersetzen“ verwenden.</span></div></div>
 <ul class="steps-list">
  <li>Das Gerät hält beim nächsten Kontakt seine Zeitpläne an und bestätigt das. Erst dann wird sein Zugang gesperrt. Ist es offline, bleibt der Stopp bis dahin unbestätigt.</li>
  <li>Die Backups bleiben unverändert im Speicherziel und lassen sich auf einem anderen Gerät des Kunden wiederherstellen. Es wird nichts gelöscht.</li>
  <li>Der direkte Zugang des Geräts zum Speicher wird dadurch nicht entzogen. Dafür die Zugangsdaten am Speicher ändern.</li>
 </ul>
 <form method="post" asp-page-handler="Decommission" asp-route-id="@d.Id" class="form-grid">
  <label class="check"><input type="checkbox" name="confirm" value="true" /> „@d.Name“ soll nicht mehr sichern.</label>
  <div><button type="submit" class="button secondary">Gerät stilllegen</button></div>
 </form>
</section>
}
