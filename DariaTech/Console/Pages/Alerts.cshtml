@page
@model AlertsModel
@using DariaTech.Console.Services
@{ ViewData["Title"] = "Warnungen"; var crit = Model.Items.Count(x => x.Severity == "Critical"); var mine = Model.Items.Count(x => x.AssignedTo == Model.Me); }
<div class="page-heading"><div><span class="eyebrow">Überwachen</span><h1>Arbeitsliste</h1><p class="lead">@Model.Items.Count offene Warnungen · @crit kritisch · @Model.Items.Count(x=>x.AssignedTo is null) unbearbeitet · @mine bei Ihnen</p></div></div>
@if(Model.Items.Count==0){<div class="empty good"><span class="empty-icon">@Ui.Icon("shield")</span><h2>Keine offenen Warnungen</h2><p>Alle überwachten Geräte melden sich und sichern planmäßig.</p></div>}
else{<section class="card card-flush"><div class="table-wrap"><table class="table"><thead><tr><th scope="col">Schweregrad</th><th scope="col">Kunde / Gerät</th><th scope="col">Problem und nächster Schritt</th><th scope="col">Letzte erfolgreiche Sicherung</th><th scope="col">Nächster Lauf</th><th scope="col">Bearbeitung</th></tr></thead><tbody>
@foreach(var row in Model.Items){var dev=Model.Devices.GetValueOrDefault(row.DeviceId);<tr>
 <td><span class="status @Ui.SeverityClass(row.Severity)">@Ui.SeverityLabel(row.Severity)</span><span class="sub">seit @Ui.Ago(row.Opened)</span></td>
 <td>@(dev?.Customer??"—")<span class="sub"><a href="/Device?id=@row.DeviceId">@(Model.Names.TryGetValue(row.DeviceId,out var n)?n:"—")</a>@if(dev is not null){<text> · @Ui.StatusLabel(dev.Status)</text>}</span></td>
 <td><strong>@Ui.AlertTitle(row.Code)</strong><span class="sub">@Ui.AlertAction(row.Code)</span></td>
 <td>@(dev?.LastSuccess is {} ok?Ui.Ago(ok):"Noch nie")@if(dev?.LastSuccess is {} at){<span class="sub">@Ui.Date(at)</span>}</td>
 <td>@Ui.In(dev?.NextRun)</td>
 <td>@if(row.AssignedTo is {} who){<span class="status waiting">In Bearbeitung</span><span class="sub">@who · seit @Ui.Ago(row.InProgressSince)</span>}else{<span class="status offline">Offen</span>}
  @if(Model.CanWork){<form method="post" asp-page-handler="Take"><input type="hidden" name="alertId" value="@row.Id" />@if(row.AssignedTo==Model.Me){<input type="hidden" name="release" value="true" /><button class="button small secondary" type="submit">Abgeben</button>}else{<button class="button small secondary" type="submit">Übernehmen</button>}</form>}</td>
</tr>}
</tbody></table></div></section>}
@if(Model.Resolved.Count>0){
<section class="card card-flush"><div class="card-head padded"><div><h2>Behoben (letzte 7 Tage)</h2><span class="sub">„Behoben“ heißt: die Überwachung erkennt das Problem nicht mehr – nicht nur, dass jemand es als erledigt markiert hat.</span></div></div>
<div class="table-wrap"><table class="table"><thead><tr><th scope="col">Problem</th><th scope="col">Gerät</th><th scope="col">Offen seit</th><th scope="col">Behoben</th></tr></thead><tbody>
@foreach(var row in Model.Resolved){<tr><td>@Ui.AlertTitle(row.Code)</td><td><a href="/Device?id=@row.DeviceId">@(Model.Names.TryGetValue(row.DeviceId,out var n)?n:"—")</a></td><td>@Ui.Date(row.Opened)</td><td><span class="status healthy">behoben</span><span class="sub">@Ui.Ago(row.Resolved)</span></td></tr>}
</tbody></table></div></section>}
