@page
@model CustomersModel
<h1>Kunden</h1><div class="cards">@foreach(var c in Model.Customers){var devices=Model.Rows.Where(x=>x.Device.TenantId==c.TenantId).ToList();<a class="panel customer" href="/Customer?id=@c.Id"><small>@c.Number</small><h2>@c.Name</h2><p>@devices.Count Geräte · @devices.Count(x=>x.Status=="Healthy") Healthy</p><p>@devices.Count(x=>x.Status=="Warning") Warning · @devices.Count(x=>x.Status=="Critical") Critical · @devices.Count(x=>x.Status=="Offline") Offline</p></a>}</div>
@if(User.IsInRole("SuperAdmin")||User.IsInRole("Administrator")){<section class="panel"><h2>Kunde anlegen</h2><form method="post" class="form-grid"><label>Firmenname<input asp-for="Input.Name" maxlength="200" required></label><label>Kundennummer<input asp-for="Input.Number" maxlength="80" required></label><label>Ansprechpartner<input asp-for="Input.Contact" maxlength="1000"></label><label>E-Mail<input asp-for="Input.Email" type="email"></label><label>Telefon<input asp-for="Input.Phone"></label><label>Adresse<input asp-for="Input.Address"></label><label>Interne Notizen<textarea asp-for="Input.Notes"></textarea></label><div asp-validation-summary="All"></div><button>Kunden anlegen</button></form></section>}
